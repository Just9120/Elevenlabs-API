{
  "version": 1,
  "disable_existing_loggers": false,
  "filters": {"safe_query": {"()": "studio_api.safe_server_logs.QueryRedactionFilter"}},
  "formatters": {
    "default": {"()": "uvicorn.logging.DefaultFormatter", "fmt": "%(levelprefix)s %(message)s", "use_colors": false},
    "access": {"()": "uvicorn.logging.AccessFormatter", "fmt": "%(levelprefix)s %(client_addr)s - \"%(request_line)s\" %(status_code)s", "use_colors": false}
  },
  "handlers": {
    "default": {"class": "logging.StreamHandler", "formatter": "default", "filters": ["safe_query"], "stream": "ext://sys.stderr"},
    "access": {"class": "logging.StreamHandler", "formatter": "access", "filters": ["safe_query"], "stream": "ext://sys.stdout"}
  },
  "loggers": {
    "uvicorn": {"handlers": ["default"], "level": "INFO", "propagate": false},
    "uvicorn.error": {"level": "INFO"},
    "uvicorn.access": {"handlers": ["access"], "level": "INFO", "propagate": false}
  }
}
